{
  "name": "ryzokuken.github.io",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build:css": "lightningcss --minify --bundle src/css/main.css -o _site/css/main.css",
    "build": "eleventy && pnpm run build:css",
    "dev": "eleventy --serve",
    "lint": "markuplint \"src/**/*.{html,liquid,md}\"",
    "test:unit": "vitest run",
    "test:links": "linkinator _site --recurse --skip \"slides\" --skip \"gc\\.zgo\\.at\" --skip \"meetup\\.com\" --skip \"web\\.archive\\.org\"",
    "test": "pnpm run test:unit && pnpm run build && pnpm run lint && pnpm run test:links",
    "prepare": "simple-git-hooks"
  },
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "download"
    }
  },
  "repository": "github:ryzokuken/ryzokuken.github.io",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryzokuken/ryzokuken.github.io/issues"
  },
  "homepage": "https://github.com/ryzokuken/ryzokuken.github.io#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@kevingimbel/eleventy-plugin-mermaid": "^3.0.1",
    "lightningcss-cli": "^1.33.0",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.5.1",
    "markuplint": "^4.18.3",
    "simple-git-hooks": "2.14.0",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "while read -r _ local_sha _ _; do case $local_sha in *[!0]*) exec pnpm validate ;; esac; done"
  }
}
