{%- for year_data in talks -%}
{%- assign year_has_past = false -%}
{%- for talk in year_data.talks -%}{%- unless talk.upcoming -%}{%- assign year_has_past = true -%}{%- endunless -%}{%- endfor -%}
{%- if year_has_past %}
<h3 id="{{ year_data.year }}">{{ year_data.year }}</h3>

{% include "talks-table.liquid", labelledby: year_data.year %}
{%- for talk in year_data.talks -%}
{%- unless talk.upcoming -%}
{%- include "talk-row.liquid" -%}
{%- endunless -%}
{%- endfor %}
  </tbody>
</table>
{%- assign year_cancelled = false -%}
{%- for talk in year_data.talks -%}{%- if talk.title contains "*" -%}{%- assign year_cancelled = true -%}{%- endif -%}{%- endfor -%}
{%- if year_cancelled %}
<p class="table-note"><span class="table-mark">*</span> Not delivered: the talk was accepted but did not take place.</p>
{%- endif %}
</div>
{%- endif %}
{%- endfor %}
