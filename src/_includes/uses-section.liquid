<h2 id="{{ section.title | slugify }}">{{ section.title }}</h2>
{%- if section.blurb %}
<div class="note"><p>{{ section.blurb }}</p></div>
{%- endif %}
<dl class="entries">
  {%- for item in section.items %}
  <div class="entry">
    <dt>
      {%- if item.url %}<a href="{{ item.url }}">{{ item.name }}</a>{% else %}{{ item.name }}{% endif -%}
      {%- assign recent = item.since | isRecent %}
      {%- if recent %} <span class="badge">New</span>{% endif -%}
    </dt>
    <dd>{{ item.note }}</dd>
  </div>
  {%- endfor %}
</dl>
