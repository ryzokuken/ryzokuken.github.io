---
layout: layout.liquid
title: Ryzokuken's Blog
clause: 4
---
<h1>Blog</h1>

{%- for post in collections.post reversed %}
<article class="post-entry">
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  {%- assign tags = post.data.tags | reject_exp: "tag", "tag == 'post'" %}
  <p class="post-meta"><time datetime="{{ post.date | date: "%Y-%m-%d" }}">{{ post.date | date: "%-d %B %Y" }}</time>{% if tags.size > 0 %} · Tagged {% for tag in tags %}<a href="/tag/{{ tag }}/">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}</p>
  <p class="post-excerpt">{{ post.templateContent | strip_html | truncatewords: 40 }}</p>
</article>
{%- endfor %}
